# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side secret. Never expose this in client code.
SUPABASE_SECRET_KEY=

# Pokémon 3D API
POKEMON_3D_API_URL=https://pokemon-3d-api.onrender.com/v1/pokemon

# AR target mode:
# demo = uses the public MindAR demo target
# local = uses /targets/pokemon-cards.mind
NEXT_PUBLIC_AR_TARGET_MODE=demo
